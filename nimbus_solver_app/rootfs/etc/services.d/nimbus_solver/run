#!/usr/bin/with-contenv bashio
# ==============================================================================
# Start the Nimbus Solver service
# s6-overlay docs: https://github.com/just-containers/s6-overlay
# ==============================================================================

declare poll_interval

poll_interval=$(bashio::config 'poll_interval_seconds')
poll_interval=${poll_interval:-60}

# NIMBUS_SOLVER_PATH points nimbus_solver_forecast_writer.py's own
# sys.path.insert() at the solver/ package the Dockerfile copied in --
# see that script's own 2026-08-21 "PORTABILITY" comment block for the
# full env-var story (this is the exact same script the NUC-cron
# deployment runs, byte-identical, driven entirely by environment here
# instead of hardcoded NUC-specific defaults).
export NIMBUS_SOLVER_PATH="/opt/nimbus_solver"

# ---------------------------------------------------------------------------
# DEPRECATED (2026-08-23, issue #76) -- this add-on will be REMOVED in v1.0.0.
#
# The Nimbus HACS integration now runs the Solver natively in-process on HAOS
# (custom_components/nimbus_load/solver_runtime.py, one-minute timer, highspy
# auto-installed as a manifest.json requirement). That path covers every
# architecture this add-on covers (amd64/aarch64 -- everywhere highspy has a
# published wheel) with less operational overhead and no three-way copy
# discipline. See the top-level README's "Producing a live dispatch forecast"
# section for the native install, or docs/real-world-integration/ for the
# standalone off-host script if you want the Solver running on a separate
# always-on device rather than inside HA's own process.
# ---------------------------------------------------------------------------
bashio::log.warning "nimbus_solver_app is DEPRECATED as of v0.73.0 and will be REMOVED in v1.0.0. The Nimbus HACS integration now runs the Solver natively in-process on HAOS -- see the top-level README's 'Producing a live dispatch forecast' section (native path) or docs/real-world-integration/ (standalone off-host script) for the paths this add-on is being retired in favour of. Tracking issue: https://github.com/code-imstillalive/nimbus/issues/76"

bashio::log.info "Nimbus Solver starting, polling every ${poll_interval}s"

while true; do
    python3 /opt/nimbus_solver/nimbus_solver_forecast_writer.py
    exit_code=$?
    if [ "${exit_code}" -ne 0 ]; then
        bashio::log.warning "Solver run exited with code ${exit_code} -- will retry next cycle, not treating as fatal"
    fi
    sleep "${poll_interval}"
done
